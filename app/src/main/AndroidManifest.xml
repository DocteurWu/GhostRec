<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickCapture">

        <!-- ICÔNE 1 SUR L'ÉCRAN D'ACCUEIL : Capture Rapide (1-Tap Toggle) -->
        <activity
            android:name=".QuickCaptureActivity"
            android:exported="true"
            android:label="Capture Rapide"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ICÔNE 2 SUR L'ÉCRAN D'ACCUEIL : Réglages & Captures -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Réglages &amp; Captures"
            android:icon="@android:drawable/ic_menu_preferences">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service d'arrière-plan pour la capture rapide (actif UNIQUEMENT pendant un enregistrement 1-Tap) -->
        <service
            android:name=".service.QuickCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- FileProvider pour écouter/ouvrir les fichiers capturés -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
